# OpenAI hosted web search 的裝置私有設定
# 複製到 ~/.config/aiy-voice/web-search.env 後填入近似位置，勿提交。
AIY_WEB_SEARCH_ENABLED=1
AIY_WEB_SEARCH_CONTEXT_SIZE=low
AIY_WEB_SEARCH_MAX_SOURCES=3
AIY_WEB_SEARCH_COUNTRY=TW
AIY_WEB_SEARCH_REGION=<縣市或行政區的英文名稱>
AIY_WEB_SEARCH_CITY=<城市的英文名稱>
AIY_WEB_SEARCH_TIMEZONE=Asia/Taipei
