# AIY Voice -> private OpenCode server (keep the real file mode 600)
# This file belongs at ~/.config/aiy-voice/opencode.env and must never be committed.
AIY_OPENCODE_BASE_URL='http://<t450-lan-address>:4096'
AIY_OPENCODE_USERNAME='aiy'
AIY_OPENCODE_PASSWORD='replace-with-the-server-password'

# Luna Fast is available through the OpenCode server authenticated with its
# own OpenAI OAuth session.  The AIY Pi does not need an OpenAI API key.
AIY_OPENCODE_MODEL='openai/gpt-5.6-luna-fast'
AIY_OPENCODE_TIMEOUT_SEC='45'

# 0 disables the former completed-turn limit.  The idle timeout remains the
# boundary for a fresh server-side session.
AIY_MEMORY_WINDOW_SEC='180'
AIY_MEMORY_MAX_TURNS='0'
