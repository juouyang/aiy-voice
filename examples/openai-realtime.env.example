# AIY Voice -> OpenAI Realtime API
#
# Copy to ~/.config/aiy-voice/openai.env, set mode 600, and replace only the
# API key.  This file is intentionally ignored by Git.
OPENAI_API_KEY='replace-with-an-openai-project-api-key'

# Set this only after the Realtime smoke test has succeeded.  The default is
# opencode_omlx, preserving the existing Mac mini + OpenCode route.
AIY_VOICE_BACKEND='openai_realtime'

# Direct speech-to-speech model and voice.  Realtime returns 24 kHz mono PCM;
# the daemon wraps it as WAV and keeps its existing ALSA playback path.
AIY_OPENAI_REALTIME_MODEL='gpt-realtime-2.1'
AIY_OPENAI_REALTIME_VOICE='marin'
AIY_OPENAI_REALTIME_TIMEOUT_SEC='90'
AIY_OPENAI_REALTIME_TRANSCRIBE_MODEL='gpt-transcribe'

# Optional: a stable, non-identifying ID for OpenAI safety enforcement.  If
# omitted, the daemon derives a one-way hash from this device's hostname.
# AIY_OPENAI_SAFETY_IDENTIFIER='replace-with-a-random-stable-device-id'
