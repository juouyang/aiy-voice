# AIY Voice -> OpenAI-compatible ASR/TTS server
#
# Copy this file to ~/.config/aiy-voice/omlx.env, replace the placeholders,
# and set mode 600.  Do not commit the real file.
OMLX_BASE_URL='http://<asr-tts-server>:8000'
OMLX_API_KEY='replace-with-the-server-api-key'

# These defaults match the reference oMLX deployment.  Change them if the
# server exposes different model names.
AIY_OMLX_ASR_MODEL='Qwen3-ASR-0.6B-8bit'
AIY_OMLX_TTS_MODEL='Qwen3-TTS-12Hz-0.6B-CustomVoice-8bit'
AIY_OMLX_TTS_LANGUAGE='Chinese'
AIY_OMLX_TTS_INSTRUCTIONS='越清楚越好。'

# Choose one dynamic TTS voice, or use a comma-separated pool to select a
# voice randomly for every completed voice turn.
AIY_OMLX_TTS_VOICE='Uncle_Fu'
# AIY_OMLX_TTS_VOICES='Vivian,Ono_Anna'
