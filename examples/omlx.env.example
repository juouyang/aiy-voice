# AIY Voice -> remote ASR plus BreezyVoice TTS services
#
# Copy this file to ~/.config/aiy-voice/omlx.env, replace the placeholders,
# and set mode 600.  Do not commit the real file.
OMLX_BASE_URL='http://<asr-server>:8000'
OMLX_API_KEY='replace-with-the-asr-api-key'

# ASR remains an OpenAI-compatible endpoint.
AIY_OMLX_ASR_MODEL='Qwen3-ASR-0.6B-8bit'
AIY_OMLX_ASR_LANGUAGE='Chinese'
AIY_OMLX_TIMEOUT_SEC='30'

# BreezyVoice TTS uses its own endpoint and credential.  AIY_TTS_SPEECH_URL
# is the full OpenAI-compatible speech endpoint, not merely the server root.
AIY_TTS_SPEECH_URL='http://<breezyvoice-server>:8001/v1/audio/speech'
AIY_TTS_API_KEY='replace-with-the-breezyvoice-api-key'
AIY_TTS_MODEL='BreezyVoice-GGUF-840M'
AIY_TTS_VOICE='zh_female'
AIY_TTS_TIMEOUT_SEC='120'
AIY_TTS_MAX_INPUT_CHARS='4096'
AIY_TTS_ASR_CONFIRMATION_PREFIX='你剛剛說：'
