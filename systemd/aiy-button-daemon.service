[Unit]
Description=AIY unified button Echo and shutdown daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ju
Group=ju
WorkingDirectory=/home/ju/aiy-voice
ExecStart=/home/ju/run-button-daemon.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
